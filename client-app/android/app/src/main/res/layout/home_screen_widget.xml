<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#388E3C"
    android:padding="12dp">

    <!-- Loading State -->
    <LinearLayout
        android:id="@+id/loading_state_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"> <!-- Default to gone, managed by code -->

        <ProgressBar
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:indeterminateTint="#4CAF50" /> <!-- Green tint -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/loading_schedule"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/empty_state_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"> <!-- Default to gone, managed by code -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/no_classes_scheduled"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="italic" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/open_app_to_sync"
            android:textColor="#BBBBBB"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Data Display State -->
    <LinearLayout
        android:id="@+id/data_display_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"> <!-- Default to gone, managed by code -->

        <!-- Current Subject -->
        <TextView
            android:id="@+id/current_subject_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/current_label"
            android:textColor="#E0E0E0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/current_subject_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subject_details_placeholder"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Spacer (Replaced View with TextView) -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            android:background="#66FFFFFF"
            android:importantForAccessibility="no" /> <!-- Important for accessibility: tell system this is not interactive text -->

        <!-- Next Subject -->
        <TextView
            android:id="@+id/next_subject_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/next_label"
            android:textColor="#B0B0B0"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/next_subject_details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subject_details_placeholder"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />
    </LinearLayout>
</RelativeLayout>
